{% extends 'base.html.twig' %}

{% block title %}Home - Blog Posts{% endblock %}

{% block body %}
<div class="container py-5">
    {# ── Page header ── #}
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Blog Posts</h1>
        <p class="text-body-secondary mb-0 small">Discover the latest articles</p>
    </div>

    {% if posts is empty %}
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="py-4">
                <i class="bi bi-journal-text text-body-tertiary" style="font-size: 3rem;"></i>
                <p class="text-body-secondary mt-3 mb-0">No posts available yet.</p>
            </div>
        </div>
    {% else %}
        {# ── Posts as cards grid ── #}
        <div class="row g-4">
            {% for post in posts %}
            <div class="col-12 col-md-6 col-lg-4">
                <a href="{{ path('app_post_show', {id: post.id}) }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    {% if post.picture %}
                        <img src="{{ post.picture }}" class="card-img-top rounded-top-4" alt="{{ post.title }}" style="max-height: 200px; object-fit: cover;">
                    {% endif %}
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill fw-medium small">
                                {{ post.category ? post.category.name : 'Sans catégorie' }}
                            </span>
                            <span class="text-body-tertiary small">
                                <i class="bi bi-calendar3 me-1"></i>
                                {{ post.publishedAt ? post.publishedAt|date('d/m/Y') : 'N/A' }}
                            </span>
                        </div>
                        <h5 class="card-title fw-semibold mb-2 text-dark">{{ post.title }}</h5>
                        <p class="card-text text-body-secondary small flex-grow-1">
                            {{ post.content|length > 120 ? post.content|slice(0, 120) ~ '...' : post.content }}
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            {% if post.user %}
                                <span class="text-body-tertiary small">
                                    <i class="bi bi-person me-1"></i>{{ post.user.firstName }}
                                </span>
                            {% endif %}
                            <span class="text-body-tertiary small">
                                <i class="bi bi-chat-dots me-1"></i>{{ post.comments|length }} commentaire{{ post.comments|length > 1 ? 's' : '' }}
                            </span>
                        </div>
                    </div>
                </div>
                </a>
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
