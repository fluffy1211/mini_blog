{% extends 'base.html.twig' %}

{% block title %}Modifier l'article - {{ post.title }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">

            {# ── Page header ── #}
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
                <div>
                    <h1 class="h3 fw-bold mb-1">Modifier l'article</h1>
                    <p class="text-body-secondary mb-0 small">Édition de « {{ post.title }} »</p>
                </div>
                <a href="{{ path('app_admin') }}" class="btn btn-outline-secondary rounded-3 px-3">
                    <i class="bi bi-arrow-left me-1"></i> Retour
                </a>
            </div>

            {# ── Edit form card ── #}
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <span class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-3" style="width:40px;height:40px;">
                            <i class="bi bi-pencil-square fs-5"></i>
                        </span>
                        <h5 class="fw-semibold mb-0">{{ post.title }}</h5>
                    </div>
                    {{ form_start(form) }}
                        {{ form_widget(form) }}
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-warning rounded-3 py-2 fw-semibold">
                                <i class="bi bi-check-lg me-1"></i> Enregistrer les modifications
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
