{% extends 'base.html.twig' %}

{% block title %}Admin - Gestion{% endblock %}

{% block body %}
<div class="container py-5">

    {% for message in app %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {# ── Page header ── #}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
        <div>
            <h1 class="h3 fw-bold mb-1"><i class="bi bi-speedometer2 me-2 text-primary"></i>Tableau de bord Admin</h1>
            <p class="text-body-secondary mb-0 small">Gérez vos articles, catégories et utilisateurs</p>
        </div>
        <a href="{{ path('app_admin_users') }}" class="btn btn-outline-primary rounded-3 px-3">
            <i class="bi bi-people me-1"></i> Gestion des utilisateurs
        </a>
    </div>

    <div class="row g-4">
        {# ── Left column: Forms ── #}
        <div class="col-12 col-lg-5">
            {# Create post form #}
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3" style="width:40px;height:40px;">
                            <i class="bi bi-pencil-square fs-5"></i>
                        </span>
                        <h5 class="fw-semibold mb-0">Créer un nouvel article</h5>
                    </div>
                    {{ form_start(postForm) }}
                        {{ form_widget(postForm) }}
                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-primary rounded-3 py-2">
                                <i class="bi bi-plus-lg me-1"></i> Enregistrer l'article
                            </button>
                        </div>
                    {{ form_end(postForm) }}
                </div>
            </div>

            {# Create category form #}
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-3" style="width:40px;height:40px;">
                            <i class="bi bi-tag fs-5"></i>
                        </span>
                        <h5 class="fw-semibold mb-0">Créer une catégorie</h5>
                    </div>
                    {{ form_start(categoryForm) }}
                        {{ form_widget(categoryForm) }}
                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-success rounded-3 py-2">
                                <i class="bi bi-plus-lg me-1"></i> Enregistrer la catégorie
                            </button>
                        </div>
                    {{ form_end(categoryForm) }}
                </div>
            </div>
        </div>

        {# ── Right column: Tables ── #}
        <div class="col-12 col-lg-7">
            {# Posts table #}
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-transparent border-0 px-4 pt-4 pb-0">
                    <h5 class="fw-semibold mb-0"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Tous les articles</h5>
                </div>
                {% if posts is empty %}
                    <div class="card-body px-4 pb-4">
                        <div class="alert alert-info rounded-3 border-0 mb-0">Aucun article pour le moment.</div>
                    </div>
                {% else %}
                    <div class="table-responsive mb-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="bg-body-secondary text-body-secondary small text-uppercase">
                                    <th scope="col" class="fw-semibold ps-4 py-3">ID</th>
                                    <th scope="col" class="fw-semibold py-3">Titre</th>
                                    <th scope="col" class="fw-semibold py-3">Contenu</th>
                                    <th scope="col" class="fw-semibold py-3">Publié le</th>
                                    <th scope="col" class="fw-semibold pe-4 py-3 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                {% for post in posts %}
                                <tr>
                                    <th scope="row" class="ps-4 text-body-secondary fw-normal">{{ post.id }}</th>
                                    <td class="fw-semibold">{{ post.title }}</td>
                                    <td class="text-body-secondary small">{{ post.content|length > 60 ? post.content|slice(0, 60) ~ '...' : post.content }}</td>
                                    <td class="text-body-secondary small">{{ post.publishedAt ? post.publishedAt|date('d/m/Y') : 'N/A' }}</td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a href="{{ path('app_admin_post_edit', {id: post.id}) }}" class="btn btn-sm btn-outline-warning rounded-3 px-2" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form action="{{ path('app_admin_post_delete', {id: post.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-post-' ~ post.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-2" title="Supprimer">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

            {# Categories table #}
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-transparent border-0 px-4 pt-4 pb-0">
                    <h5 class="fw-semibold mb-0"><i class="bi bi-tags me-2 text-success"></i>Toutes les catégories</h5>
                </div>
                {% if categories is empty %}
                    <div class="card-body px-4 pb-4">
                        <div class="alert alert-info rounded-3 border-0 mb-0">Aucune catégorie pour le moment.</div>
                    </div>
                {% else %}
                    <div class="table-responsive mb-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="bg-body-secondary text-body-secondary small text-uppercase">
                                    <th scope="col" class="fw-semibold ps-4 py-3">ID</th>
                                    <th scope="col" class="fw-semibold py-3">Nom</th>
                                    <th scope="col" class="fw-semibold pe-4 py-3">Description</th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                {% for category in categories %}
                                <tr>
                                    <th scope="row" class="ps-4 text-body-secondary fw-normal">{{ category.id }}</th>
                                    <td class="fw-semibold">{{ category.name }}</td>
                                    <td class="pe-4 text-body-secondary">{{ category.description ?? 'N/A' }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}