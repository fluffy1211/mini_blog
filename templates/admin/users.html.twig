{% extends 'base.html.twig' %}

{% block title %}Admin - Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="container py-5">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {# ── Page header ── #}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Gestion des utilisateurs</h1>
            <p class="text-body-secondary mb-0 small">Consultez et gérez les comptes enregistrés</p>
        </div>
        <a href="{{ path('app_admin') }}" class="btn btn-outline-secondary rounded-3 px-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-1" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/></svg>
            Retour au tableau de bord
        </a>
    </div>

    {% if users is empty %}
        <div class="alert alert-info rounded-3 shadow-sm border-0">Aucun utilisateur inscrit.</div>
    {% else %}
        {# ── Users table card ── #}
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive mb-0">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="bg-body-secondary text-body-secondary small text-uppercase">
                            <th scope="col" class="fw-semibold ps-4 py-3">ID</th>
                            <th scope="col" class="fw-semibold py-3">Prénom</th>
                            <th scope="col" class="fw-semibold py-3">Nom</th>
                            <th scope="col" class="fw-semibold py-3">Email</th>
                            <th scope="col" class="fw-semibold py-3">Rôles</th>
                            <th scope="col" class="fw-semibold py-3">Statut</th>
                            <th scope="col" class="fw-semibold py-3">Inscrit le</th>
                            <th scope="col" class="fw-semibold pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        {% for user in users %}
                        <tr>
                            <th scope="row" class="ps-4 text-body-secondary fw-normal">{{ user.id }}</th>
                            <td class="fw-semibold">{{ user.firstName }}</td>
                            <td>{{ user.lastName }}</td>
                            <td><span class="text-body-secondary">{{ user.email }}</span></td>
                            <td>
                                {% for role in user.roles %}
                                    <span class="badge rounded-pill bg-{{ role == 'ROLE_ADMIN' ? 'danger' : 'secondary' }} bg-opacity-10 text-{{ role == 'ROLE_ADMIN' ? 'danger' : 'secondary' }} fw-medium">{{ role }}</span>
                                {% endfor %}
                            </td>
                            <td class="pe-4 text-body-secondary small">{{ user.createdAt ? user.createdAt|date('d/m/Y') : 'N/A' }}</td>
                            <td>
                                {% if user.isActive %}
                                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success fw-medium">Actif</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger fw-medium">Désactivé</span>
                                {% endif %}
                            </td>
                            <td class="text-body-secondary small">{{ user.createdAt ? user.createdAt|date('d/m/Y') : 'N/A' }}</td>
                            <td class="pe-4 text-end">
                                <form action="{{ path('app_admin_user_toggle', {id: user.id}) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle-user-' ~ user.id) }}">
                                    {% if user.isActive %}
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-2" title="Désactiver" onclick="return confirm('Désactiver le compte de {{ user.firstName }} {{ user.lastName }} ?');">
                                            <i class="bi bi-person-slash"></i>
                                        </button>
                                    {% else %}
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-3 px-2" title="Activer" onclick="return confirm('Activer le compte de {{ user.firstName }} {{ user.lastName }} ?');">
                                            <i class="bi bi-person-check"></i>
                                        </button>
                                    {% endif %}
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ── Footer ── #}
            <div class="card-footer bg-body-tertiary border-top-0 px-4 py-3">
                <span class="text-body-secondary small">
                    Total : <strong>{{ users|length }}</strong> utilisateur{{ users|length > 1 ? 's' : '' }}
                </span>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
