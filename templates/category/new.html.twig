{% extends 'base.html.twig' %}

{% block title %}Nouvelle catégorie - Mini Blog{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <a href="{{ path('app_category') }}" class="btn btn-outline-secondary rounded-3 px-3 mb-4">
                <i class="bi bi-arrow-left me-1"></i> Retour aux catégories
            </a>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-3" style="width:40px;height:40px;">
                            <i class="bi bi-tag fs-5"></i>
                        </span>
                        <h5 class="fw-semibold mb-0">Créer une catégorie</h5>
                    </div>
                    {{ form_start(form) }}
                        {{ form_widget(form) }}
                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-success rounded-3 py-2">
                                <i class="bi bi-plus-lg me-1"></i> Enregistrer la catégorie
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
