{% extends 'base.html.twig' %}

{% block title %}Catégories - Mini Blog{% endblock %}

{% block body %}
<div class="container py-5">

    {# ── Page header ── #}
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-tags me-2 text-primary"></i>Catégories</h1>
        <p class="text-body-secondary mb-0 small">Parcourez les articles par catégorie</p>
    </div>

    {% if categories is empty %}
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="py-4">
                <i class="bi bi-tags text-body-tertiary" style="font-size: 3rem;"></i>
                <p class="text-body-secondary mt-3 mb-0">Aucune catégorie pour le moment.</p>
            </div>
        </div>
    {% else %}
        <div class="row g-4">
            {% for category in categories %}
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-semibold mb-2">
                            <i class="bi bi-tag me-1 text-primary"></i>{{ category.name }}
                        </h5>
                        <p class="card-text text-body-secondary small flex-grow-1">
                            {{ category.description ?? 'Aucune description.' }}
                        </p>
                        <div class="mt-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill fw-medium">
                                {{ category.posts|length }} article{{ category.posts|length > 1 ? 's' : '' }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
