<header class="d-flex justify-content-between align-items-center py-3 px-3">
      <ul class="nav nav-pills">
        <li class="nav-item"><a href="{{ path('app_home') }}" class="nav-link">Home</a></li>
        {# <li class="nav-item"><a href="{{ path('app_category') }}" class="nav-link">Categories</a></li> #}
        {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-item"><a href="{{ path('app_admin') }}" class="nav-link">Admin</a></li>
        {% endif %}
      </ul>
      
      <div class="d-flex align-items-center">
        {% if app.user %}
            <span class="me-3">Hello {{ app.user.firstName }}!</span>
            <a href="{{ path('app_logout') }}" class="btn btn-outline-primary btn-sm">Logout</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-sm me-2">Login</a>
            <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm">Register</a>
        {% endif %}
      </div>
</header>